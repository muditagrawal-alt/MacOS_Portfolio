# What a Vercel deploy leaves out. The site and api/ are all it needs.

# Never upload secrets or local state (the CLI uploads the working folder,
# and Vercel's own defaults don't skip .env).
.env
.env.*
!.env.example
.portfolio/
node_modules/
scratch/
test-results/

# The setup questionnaire, the admin and the tooling stay on your computer.
setup/
scripts/
