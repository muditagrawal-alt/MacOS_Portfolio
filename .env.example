# Example Environment Configuration (DO NOT STORE REAL SECRETS HERE)
# Copy this file to .env and insert your real keys locally or on Vercel/Netlify.
# .env is strictly ignored by git to protect your credentials.

# AI Model Keys (Serverless Proxy Only - Never expose client-side)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Email / Notification Service IDs
EMAILJS_SERVICE_ID=your_emailjs_service_id_here
WEB3FORMS_FORM_ACCESS_KEY=your_web3forms_access_key_here
