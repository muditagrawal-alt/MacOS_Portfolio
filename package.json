{
  "name": "macos-portfolio",
  "version": "3.0.0",
  "description": "An interactive macOS and iPhone portfolio. Clone it, answer one questionnaire, and it is yours.",
  "main": "index.html",
  "scripts": {
    "start": "node scripts/dev-server.js",
    "setup": "node scripts/dev-server.js --setup",
    "admin": "node scripts/dev-server.js --admin",
    "refresh": "node setup/apply.js refresh",
    "test:syntax": "node scripts/test-syntax.js",
    "test:assets": "node scripts/test-assets.js",
    "test:components": "node scripts/test-components.js",
    "test:template": "node scripts/test-template.js",
    "test:e2e": "node scripts/test-e2e.js",
    "test": "npm run test:syntax && npm run test:assets && npm run test:components && npm run test:template",
    "test:all": "npm test && npm run test:e2e",
    "validate": "npm run test:all"
  },
  "keywords": [
    "portfolio",
    "macos",
    "finder",
    "interactive",
    "apple-music",
    "iris-siri",
    "vanilla-javascript",
    "ios",
    "template",
    "portfolio-template"
  ],
  "author": "Mudit Agrawal",
  "license": "MIT",
  "devDependencies": {
    "jsdom": "^30.1.2",
    "playwright": "^1.64.1"
  }
}
